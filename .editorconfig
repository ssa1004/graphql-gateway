# EditorConfig — 모듈 / 파일 종류별 공통 들여쓰기 규칙. (https://editorconfig.org)
# IDE / 에디터가 자동으로 적용 (IntelliJ / VS Code 기본 지원).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# Kotlin — official 스타일과 동일하게 4-space.
[*.{kt,kts}]
indent_size = 4

# Gradle 스크립트도 동일.
[*.gradle.kts]
indent_size = 4

# YAML / JSON — Helm / Kubernetes / GitHub Actions / GraphQL config 관례로 2-space.
[*.{yml,yaml,json}]
indent_size = 2

# GraphQL SDL — 2-space 가 일반적.
[*.graphqls]
indent_size = 2

# Markdown — trailing space 가 의미를 가지므로 trim 제외 (line break).
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Shell — POSIX sh / bash.
[*.sh]
indent_size = 2

# Properties — JVM 표기 그대로.
[*.properties]
indent_size = 2
